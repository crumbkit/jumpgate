{
  "$type": "jumpgate/plan/v1alpha1",
  "target": {
    "name": "local",
    "kind": "local"
  },
  "unbound": [
    {
      "need": "/jumpgate/needs/shelf/session-key",
      "when_unbound": "omit",
      "reason": "no_offer"
    }
  ],
  "units": [
    {
      "app": "auth",
      "name": "server",
      "repo": "github.com/acme/auth",
      "kind": "process",
      "starts_after": [],
      "addresses": [
        "api"
      ],
      "bindings": []
    },
    {
      "app": "shelf",
      "name": "web",
      "repo": "github.com/acme/shelf",
      "kind": "process",
      "starts_after": [
        "db"
      ],
      "addresses": [
        "http"
      ],
      "bindings": [
        {
          "need": "/jumpgate/needs/shelf/api-token",
          "offer": "/jumpgate/offers/secret-store/one-password/api-token",
          "via": "bind",
          "delivers_as": {
            "variables": [
              "API_TOKEN"
            ]
          },
          "supplies": {
            "fallback": "not-a-real-secret"
          }
        },
        {
          "need": "/jumpgate/needs/shelf/auth-api",
          "offer": "/jumpgate/offers/app/auth/api",
          "via": "want",
          "delivers_as": {
            "variables": [
              "AUTH_API_URL"
            ]
          },
          "supplies": {
            "reference": {
              "port": {
                "app": "auth",
                "port": "api"
              }
            }
          }
        }
      ]
    },
    {
      "app": "shelf",
      "name": "db",
      "repo": "github.com/acme/shelf",
      "kind": "container",
      "starts_after": [],
      "addresses": [],
      "bindings": []
    }
  ],
  "adapter": {}
}
