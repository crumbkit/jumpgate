{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "jumpgate/resolve/v1",
  "description": "The plan for one target, the needs left unbound and what the matcher noted.",
  "type": "object",
  "properties": {
    "data": {
      "$ref": "#/$defs/Report"
    },
    "dry_run": {
      "description": "Present, and true, when the run was a dry run that changed nothing.",
      "const": true
    },
    "failures": {
      "description": "The failures that the answer leaves out. It is empty when nothing failed.",
      "type": "array",
      "items": {
        "description": "A failure of some of the ids: the fields of the failure document without schema.",
        "type": "object",
        "properties": {
          "alternatives": {
            "description": "Other repairs the caller can try, in order of preference, each in the shape of recovery. It is present only when the failure offers at least one.",
            "type": "array",
            "items": {
              "description": "A repair the caller can try instead, tagged by kind.",
              "oneOf": [
                {
                  "description": "Run this command. With `all`, run it once with every value of the failure's field that `all` names in place of the argument's placeholder, such as `<ID>...`.",
                  "type": "object",
                  "properties": {
                    "all": {
                      "type": "string"
                    },
                    "call": {
                      "type": "string"
                    },
                    "kind": {
                      "const": "run"
                    }
                  },
                  "required": [
                    "kind",
                    "call"
                  ]
                },
                {
                  "description": "A person must run this command in a terminal, so a program should hand the step to a person.",
                  "type": "object",
                  "properties": {
                    "call": {
                      "type": "string"
                    },
                    "kind": {
                      "const": "terminal"
                    }
                  },
                  "required": [
                    "kind",
                    "call"
                  ]
                },
                {
                  "description": "Run this command of another program. `run` is the quoted command line that the text output prints.",
                  "type": "object",
                  "properties": {
                    "args": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "kind": {
                      "const": "program"
                    },
                    "program": {
                      "type": "string"
                    },
                    "run": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "program",
                    "args",
                    "run"
                  ]
                },
                {
                  "description": "Run the same command again later.",
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "retry"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                {
                  "description": "Make this repair, then take the step `then`.",
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "after"
                    },
                    "repair": {
                      "type": "string"
                    },
                    "then": {
                      "description": "The step that follows the repair.",
                      "oneOf": [
                        {
                          "description": "Run this command. With `all`, run it once with every value of the failure's field that `all` names in place of the argument's placeholder, such as `<ID>...`.",
                          "type": "object",
                          "properties": {
                            "all": {
                              "type": "string"
                            },
                            "call": {
                              "type": "string"
                            },
                            "kind": {
                              "const": "run"
                            }
                          },
                          "required": [
                            "kind",
                            "call"
                          ]
                        },
                        {
                          "description": "A person must run this command in a terminal, so a program should hand the step to a person.",
                          "type": "object",
                          "properties": {
                            "call": {
                              "type": "string"
                            },
                            "kind": {
                              "const": "terminal"
                            }
                          },
                          "required": [
                            "kind",
                            "call"
                          ]
                        },
                        {
                          "description": "Run the same command again later.",
                          "type": "object",
                          "properties": {
                            "kind": {
                              "const": "retry"
                            }
                          },
                          "required": [
                            "kind"
                          ]
                        }
                      ]
                    }
                  },
                  "required": [
                    "kind",
                    "repair",
                    "then"
                  ]
                },
                {
                  "description": "Follow this advice.",
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "hint"
                    },
                    "text": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "text"
                  ]
                },
                {
                  "description": "There is no next step, for this reason.",
                  "type": "object",
                  "properties": {
                    "kind": {
                      "const": "none"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind",
                    "reason"
                  ]
                }
              ]
            }
          },
          "cause": {
            "description": "The errors that led to the failure, joined with \": \". It is present only when the failure has a cause.",
            "type": "string"
          },
          "causes": {
            "description": "The reasons the failure lists side by side, in order, one sentence each. It is present only when the failure lists at least one.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "code": {
            "description": "The failure's stable code, such as shelf::books::not_found. It is one or more printable ASCII characters without spaces, from ! to ~.",
            "type": "string",
            "pattern": "^[!-~]+$"
          },
          "fields": {
            "description": "The values at fault, in the order the failure gives them, each under a name of one or more lowercase ASCII letters, digits and underscores. A value is a string, an integer, a boolean, null, or an array or object of such values, and an object holds each key once. It is present only when the failure names at least one.",
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "integer",
                "boolean",
                "null",
                "array",
                "object"
              ],
              "$anchor": "field_value",
              "additionalProperties": {
                "$ref": "#field_value"
              },
              "items": {
                "$ref": "#field_value"
              }
            },
            "propertyNames": {
              "pattern": "^[a-z0-9_]+$"
            }
          },
          "index": {
            "description": "The position of key among the keys that the caller gave, counted from 0, so two failures of the same key differ. It is present only with key.",
            "type": "integer",
            "minimum": 0
          },
          "key": {
            "description": "The key that the caller gave for the answer that failed, when the failure is one answer of a batch.",
            "type": "string"
          },
          "labels": {
            "description": "The places in a source, such as a file, that the failure points at, in the order the failure gives them. It is present only when the failure has at least one label.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "column": {
                  "description": "The 1-based column of the start of the span, counted in characters of its line. It is present only when the span could be read.",
                  "type": "integer",
                  "minimum": 1
                },
                "excerpt": {
                  "description": "The lines of the source that the span covers, with one line before and one after where the source has them. It is present only when the span could be read.",
                  "type": "object",
                  "properties": {
                    "line": {
                      "description": "The 1-based number of the first line of the excerpt.",
                      "type": "integer",
                      "minimum": 1
                    },
                    "text": {
                      "description": "The lines, joined by the line breaks of the source, without a line break at the end.",
                      "type": "string"
                    }
                  },
                  "required": [
                    "line",
                    "text"
                  ]
                },
                "length": {
                  "description": "The length of the span in bytes.",
                  "type": "integer",
                  "minimum": 0
                },
                "line": {
                  "description": "The 1-based line that holds the start of the span. It is present only when the span could be read.",
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "description": "The name of the source, such as a file name. It is present only when the span could be read and the source has a name.",
                  "type": "string"
                },
                "offset": {
                  "description": "The byte offset of the start of the span from the start of the source.",
                  "type": "integer",
                  "minimum": 0
                },
                "text": {
                  "description": "What the label says about the span. It is present only when the label has text.",
                  "type": "string"
                }
              },
              "required": [
                "offset",
                "length"
              ]
            }
          },
          "message": {
            "description": "What went wrong.",
            "type": "string"
          },
          "recovery": {
            "description": "What the caller can do next, tagged by kind.",
            "oneOf": [
              {
                "description": "Run this command. With `all`, run it once with every value of the failure's field that `all` names in place of the argument's placeholder, such as `<ID>...`.",
                "type": "object",
                "properties": {
                  "all": {
                    "type": "string"
                  },
                  "call": {
                    "type": "string"
                  },
                  "kind": {
                    "const": "run"
                  }
                },
                "required": [
                  "kind",
                  "call"
                ]
              },
              {
                "description": "A person must run this command in a terminal, so a program should hand the step to a person.",
                "type": "object",
                "properties": {
                  "call": {
                    "type": "string"
                  },
                  "kind": {
                    "const": "terminal"
                  }
                },
                "required": [
                  "kind",
                  "call"
                ]
              },
              {
                "description": "Run this command of another program. `run` is the quoted command line that the text output prints.",
                "type": "object",
                "properties": {
                  "args": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "kind": {
                    "const": "program"
                  },
                  "program": {
                    "type": "string"
                  },
                  "run": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "program",
                  "args",
                  "run"
                ]
              },
              {
                "description": "Run the same command again later.",
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "retry"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              {
                "description": "Make this repair, then take the step `then`.",
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "after"
                  },
                  "repair": {
                    "type": "string"
                  },
                  "then": {
                    "description": "The step that follows the repair.",
                    "oneOf": [
                      {
                        "description": "Run this command. With `all`, run it once with every value of the failure's field that `all` names in place of the argument's placeholder, such as `<ID>...`.",
                        "type": "object",
                        "properties": {
                          "all": {
                            "type": "string"
                          },
                          "call": {
                            "type": "string"
                          },
                          "kind": {
                            "const": "run"
                          }
                        },
                        "required": [
                          "kind",
                          "call"
                        ]
                      },
                      {
                        "description": "A person must run this command in a terminal, so a program should hand the step to a person.",
                        "type": "object",
                        "properties": {
                          "call": {
                            "type": "string"
                          },
                          "kind": {
                            "const": "terminal"
                          }
                        },
                        "required": [
                          "kind",
                          "call"
                        ]
                      },
                      {
                        "description": "Run the same command again later.",
                        "type": "object",
                        "properties": {
                          "kind": {
                            "const": "retry"
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      }
                    ]
                  }
                },
                "required": [
                  "kind",
                  "repair",
                  "then"
                ]
              },
              {
                "description": "Follow this advice.",
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "hint"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "text"
                ]
              },
              {
                "description": "There is no next step, for this reason.",
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "none"
                  },
                  "reason": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "reason"
                ]
              }
            ]
          },
          "related": {
            "description": "The diagnostics that the failure's diagnostic relates to it, in the order it gives them. It is present only when there is at least one.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "cause": {
                  "description": "The errors below the related diagnostic, joined with \": \". It is present only when there is one.",
                  "type": "string"
                },
                "code": {
                  "description": "The related diagnostic's own code, which is free text. It is present only when the diagnostic has one.",
                  "type": "string"
                },
                "help": {
                  "description": "The related diagnostic's advice. It is present only when it gives some.",
                  "type": "string"
                },
                "labels": {
                  "description": "The places in a source, such as a file, that the failure points at, in the order the failure gives them. It is present only when the failure has at least one label.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "column": {
                        "description": "The 1-based column of the start of the span, counted in characters of its line. It is present only when the span could be read.",
                        "type": "integer",
                        "minimum": 1
                      },
                      "excerpt": {
                        "description": "The lines of the source that the span covers, with one line before and one after where the source has them. It is present only when the span could be read.",
                        "type": "object",
                        "properties": {
                          "line": {
                            "description": "The 1-based number of the first line of the excerpt.",
                            "type": "integer",
                            "minimum": 1
                          },
                          "text": {
                            "description": "The lines, joined by the line breaks of the source, without a line break at the end.",
                            "type": "string"
                          }
                        },
                        "required": [
                          "line",
                          "text"
                        ]
                      },
                      "length": {
                        "description": "The length of the span in bytes.",
                        "type": "integer",
                        "minimum": 0
                      },
                      "line": {
                        "description": "The 1-based line that holds the start of the span. It is present only when the span could be read.",
                        "type": "integer",
                        "minimum": 1
                      },
                      "name": {
                        "description": "The name of the source, such as a file name. It is present only when the span could be read and the source has a name.",
                        "type": "string"
                      },
                      "offset": {
                        "description": "The byte offset of the start of the span from the start of the source.",
                        "type": "integer",
                        "minimum": 0
                      },
                      "text": {
                        "description": "What the label says about the span. It is present only when the label has text.",
                        "type": "string"
                      }
                    },
                    "required": [
                      "offset",
                      "length"
                    ]
                  }
                },
                "message": {
                  "description": "What the related diagnostic says.",
                  "type": "string"
                },
                "related": {
                  "description": "The diagnostics related to this one, in the same shape, to at most eight levels below the failure.",
                  "type": "array",
                  "items": {
                    "$ref": "#related"
                  }
                },
                "severity": {
                  "description": "How severe the related diagnostic is. A diagnostic that gives no severity is an error.",
                  "enum": [
                    "error",
                    "warning",
                    "advice"
                  ]
                },
                "url": {
                  "description": "A page that explains the related diagnostic. It is present only when it has one.",
                  "type": "string"
                }
              },
              "$anchor": "related",
              "required": [
                "message",
                "severity"
              ]
            }
          },
          "sentence": {
            "description": "A fixed sentence that a person reviewed, safe to show to anyone. It is present only when the failure has one.",
            "type": "string"
          },
          "url": {
            "description": "A page that explains the failure. It is present only when the failure has one.",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "recovery"
        ]
      }
    },
    "schema": {
      "description": "The id of this document.",
      "const": "jumpgate/resolve/v1"
    }
  },
  "required": [
    "schema",
    "data",
    "failures"
  ],
  "$defs": {
    "Adapter": {
      "description": "The block that a target adapter owns. The matcher writes it empty.",
      "type": "object",
      "additionalProperties": false
    },
    "DeliversAs": {
      "description": "What a need is delivered as: environment variables or a file.\n\nA later version may add a way to deliver a need, so a `match` outside\nthe crate needs a wildcard arm:\n\n```compile_fail,E0004\nfn is_file(delivers_as: &jumpgate::DeliversAs) -> bool {\n    match delivers_as {\n        jumpgate::DeliversAs::Variables(_) => false,\n        jumpgate::DeliversAs::File(_) => true,\n    }\n}\n```",
      "oneOf": [
        {
          "description": "One or more environment variables, each of which receives the value.",
          "type": "object",
          "properties": {
            "variables": {
              "type": "array",
              "items": {
                "description": "Names an environment variable: ASCII letters, digits and '_', not starting with a digit, at most 128 bytes.",
                "type": "string",
                "maxLength": 128,
                "minLength": 1,
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": false,
          "required": [
            "variables"
          ]
        },
        {
          "description": "A file whose content is the value.",
          "type": "object",
          "properties": {
            "file": {
              "description": "Names the file a need is delivered as, absolute or relative to the unit's working directory; no segment is empty, '.' or '..', and none holds a '\\' or a control character. The path has at most 1024 bytes, which maxLength cannot check for text outside ASCII because it counts characters.",
              "type": "string",
              "maxLength": 1024,
              "minLength": 1,
              "pattern": "^/?(?:[^/.\\\\\\x00-\\x1F\\x7F-\\x9F][^/\\\\\\x00-\\x1F\\x7F-\\x9F]*|\\.[^/.\\\\\\x00-\\x1F\\x7F-\\x9F][^/\\\\\\x00-\\x1F\\x7F-\\x9F]*|\\.\\.[^/\\\\\\x00-\\x1F\\x7F-\\x9F]+)(?:/(?:[^/.\\\\\\x00-\\x1F\\x7F-\\x9F][^/\\\\\\x00-\\x1F\\x7F-\\x9F]*|\\.[^/.\\\\\\x00-\\x1F\\x7F-\\x9F][^/\\\\\\x00-\\x1F\\x7F-\\x9F]*|\\.\\.[^/\\\\\\x00-\\x1F\\x7F-\\x9F]+))*$"
            }
          },
          "additionalProperties": false,
          "required": [
            "file"
          ]
        }
      ]
    },
    "Plan": {
      "description": "A plan for one target.",
      "type": "object",
      "properties": {
        "$type": {
          "type": "string",
          "const": "jumpgate/plan/v1alpha1"
        },
        "adapter": {
          "$ref": "#/$defs/Adapter"
        },
        "target": {
          "$ref": "#/$defs/PlanTarget"
        },
        "unbound": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Unbound"
          }
        },
        "units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanUnit"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "$type",
        "target",
        "unbound",
        "units",
        "adapter"
      ]
    },
    "PlanBinding": {
      "description": "A need matched for a unit.",
      "type": "object",
      "properties": {
        "audience": {
          "description": "Names an audience: 1 to 64 lowercase letters, digits, '-' and '_', starting with a letter or a digit.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "consumers": {
          "type": "array",
          "items": {
            "description": "Names a unit: 1 to 64 letters, digits, '-' and '_', starting with a letter or a digit.",
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "delivers_as": {
          "$ref": "#/$defs/DeliversAs"
        },
        "kind": {
          "type": "string",
          "enum": [
            "secret",
            "address",
            "value",
            "data-access",
            "capability",
            "app"
          ]
        },
        "need": {
          "description": "References a need record at /jumpgate/needs/<app>/<name>.",
          "type": "string",
          "format": "board-ref",
          "pattern": "^/jumpgate/needs/[a-z0-9][a-z0-9_-]{0,63}/[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "offer": {
          "description": "References an offer record at /jumpgate/offers/<provider-kind>/<provider>/<name>.",
          "type": "string",
          "format": "board-ref",
          "pattern": "^/jumpgate/offers/(secret-store|app|workspace|capability|cloud-environment|identity-broker)/[a-z0-9][a-z0-9_-]{0,63}/[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "projection": {
          "description": "Names a projection: 1 to 64 lowercase letters, digits, '-' and '_', starting with a letter or a digit.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "supplies": {
          "$ref": "#/$defs/Supplies"
        },
        "via": {
          "$ref": "#/$defs/Via"
        }
      },
      "additionalProperties": false,
      "required": [
        "need",
        "kind",
        "consumers",
        "via",
        "delivers_as",
        "supplies"
      ]
    },
    "PlanTarget": {
      "description": "The target a plan is for.",
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "local",
            "cloud"
          ]
        },
        "name": {
          "description": "Names a target: 1 to 64 lowercase letters, digits, '-' and '_', starting with a letter or a digit.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ]
    },
    "PlanUnit": {
      "description": "A unit of the plan: a process or container, where it comes from, what it\nstarts after, the ports it serves and what it receives.",
      "type": "object",
      "properties": {
        "addresses": {
          "type": "array",
          "items": {
            "description": "Names a port: 1 to 64 letters, digits, '-' and '_', starting with a letter or a digit.",
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "app": {
          "description": "Names an app: 1 to 64 lowercase letters, digits, '-' and '_', starting with a letter or a digit.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PlanBinding"
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "process",
            "container"
          ]
        },
        "name": {
          "description": "Names a unit: 1 to 64 letters, digits, '-' and '_', starting with a letter or a digit.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        },
        "repo": {
          "description": "Names a repository as host/owner/name, in lowercase, such as github.com/acme/shelf.",
          "type": "string",
          "maxLength": 255,
          "minLength": 5,
          "pattern": "^[a-z0-9-]+(\\.[a-z0-9-]+)+/[a-z0-9_-]+(\\.[a-z0-9_-]+)*\\.?/[a-z0-9_-]+(\\.[a-z0-9_-]+)*\\.?$"
        },
        "starts_after": {
          "type": "array",
          "items": {
            "description": "Names a unit: 1 to 64 letters, digits, '-' and '_', starting with a letter or a digit.",
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "app",
        "name",
        "repo",
        "kind",
        "starts_after",
        "addresses",
        "bindings"
      ]
    },
    "PortReference": {
      "description": "A port of an app, such as the port `http` of `auth`.",
      "type": "object",
      "properties": {
        "app": {
          "description": "The app.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "port": {
          "description": "The port's name.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        }
      },
      "additionalProperties": false,
      "required": [
        "app",
        "port"
      ]
    },
    "Reference": {
      "description": "Where an offer's value lives. No variant can hold a secret value: a\nsecret is named by its secret-store reference, and everything else by\nthe app and the name of its port, route or unit.",
      "oneOf": [
        {
          "description": "A secret in a secret store.",
          "type": "object",
          "properties": {
            "secret": {
              "description": "References a secret in a secret store as op://<vault>/<item>/<field> or op://<vault>/<item>/<section>/<field>; each part is not empty, '.' or '..' and holds no control character. It names where the secret lives and never holds the secret.",
              "type": "string",
              "pattern": "^op://(?:[^/.\\x00-\\x1F\\x7F-\\x9F][^/\\x00-\\x1F\\x7F-\\x9F]*|\\.[^/.\\x00-\\x1F\\x7F-\\x9F][^/\\x00-\\x1F\\x7F-\\x9F]*|\\.\\.[^/\\x00-\\x1F\\x7F-\\x9F]+)/(?:[^/.\\x00-\\x1F\\x7F-\\x9F][^/\\x00-\\x1F\\x7F-\\x9F]*|\\.[^/.\\x00-\\x1F\\x7F-\\x9F][^/\\x00-\\x1F\\x7F-\\x9F]*|\\.\\.[^/\\x00-\\x1F\\x7F-\\x9F]+)(?:/(?:[^/.\\x00-\\x1F\\x7F-\\x9F][^/\\x00-\\x1F\\x7F-\\x9F]*|\\.[^/.\\x00-\\x1F\\x7F-\\x9F][^/\\x00-\\x1F\\x7F-\\x9F]*|\\.\\.[^/\\x00-\\x1F\\x7F-\\x9F]+))?/(?:[^/.\\x00-\\x1F\\x7F-\\x9F][^/\\x00-\\x1F\\x7F-\\x9F]*|\\.[^/.\\x00-\\x1F\\x7F-\\x9F][^/\\x00-\\x1F\\x7F-\\x9F]*|\\.\\.[^/\\x00-\\x1F\\x7F-\\x9F]+)$"
            }
          },
          "additionalProperties": false,
          "required": [
            "secret"
          ]
        },
        {
          "description": "A port of an app, reached directly.",
          "type": "object",
          "properties": {
            "port": {
              "$ref": "#/$defs/PortReference"
            }
          },
          "additionalProperties": false,
          "required": [
            "port"
          ]
        },
        {
          "description": "A route of an app, a port that the proxy serves.",
          "type": "object",
          "properties": {
            "route": {
              "$ref": "#/$defs/RouteReference"
            }
          },
          "additionalProperties": false,
          "required": [
            "route"
          ]
        },
        {
          "description": "A unit of an app.",
          "type": "object",
          "properties": {
            "unit": {
              "$ref": "#/$defs/UnitReference"
            }
          },
          "additionalProperties": false,
          "required": [
            "unit"
          ]
        }
      ]
    },
    "Report": {
      "description": "What `jumpgate resolve` matched.",
      "type": "object",
      "properties": {
        "kind": {
          "description": "The kind of the target, `local` or `cloud`.",
          "type": "string"
        },
        "notes": {
          "description": "What the matcher noted that is not a failure: a fallback it bound, a\nbinding it ignored, a consumer without a unit, a need that does not\napply to the target.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "out": {
          "description": "The file the plan was written to, when `--out` named one.",
          "type": "string"
        },
        "plan": {
          "description": "The plan, with the needs that nothing binds listed first.",
          "$ref": "#/$defs/Plan"
        },
        "store": {
          "description": "The directory the records were read from.",
          "type": "string"
        },
        "target": {
          "description": "The name of the target.",
          "type": "string"
        }
      },
      "required": [
        "target",
        "kind",
        "store",
        "notes",
        "plan"
      ]
    },
    "RouteReference": {
      "description": "A route of an app: the port that the proxy serves.",
      "type": "object",
      "properties": {
        "app": {
          "description": "The app.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "port": {
          "description": "The name of the port that the proxy serves.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        }
      },
      "additionalProperties": false,
      "required": [
        "app",
        "port"
      ]
    },
    "Supplies": {
      "description": "What a binding supplies to a unit: the reference of an offer, or the\nfallback value of a local target. It never holds a secret value.",
      "oneOf": [
        {
          "description": "The reference of the offer, such as an `op://` secret reference or\nan app's port.",
          "type": "object",
          "properties": {
            "reference": {
              "$ref": "#/$defs/Reference"
            }
          },
          "additionalProperties": false,
          "required": [
            "reference"
          ]
        },
        {
          "description": "The placeholder value of a need's fallback. A fallback is for a\nlocal target only.",
          "type": "object",
          "properties": {
            "fallback": {
              "description": "The value a need receives on a local target when nothing binds it. It is a placeholder and never a real secret. It holds no NUL character and has at most 4096 bytes, which maxLength cannot check for text outside ASCII because it counts characters.",
              "type": "string",
              "maxLength": 4096,
              "pattern": "^[^\\x00]*$"
            }
          },
          "additionalProperties": false,
          "required": [
            "fallback"
          ]
        }
      ]
    },
    "Unbound": {
      "description": "A need that no binding meets, with the need's own answer to that.",
      "type": "object",
      "properties": {
        "consumers": {
          "type": "array",
          "items": {
            "description": "Names a unit: 1 to 64 letters, digits, '-' and '_', starting with a letter or a digit.",
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "kind": {
          "type": "string",
          "enum": [
            "secret",
            "address",
            "value",
            "data-access",
            "capability",
            "app"
          ]
        },
        "need": {
          "description": "References a need record at /jumpgate/needs/<app>/<name>.",
          "type": "string",
          "format": "board-ref",
          "pattern": "^/jumpgate/needs/[a-z0-9][a-z0-9_-]{0,63}/[a-z0-9][a-z0-9_-]{0,63}$"
        },
        "reason": {
          "$ref": "#/$defs/UnboundReason"
        },
        "when_unbound": {
          "$ref": "#/$defs/UnboundAction"
        }
      },
      "additionalProperties": false,
      "required": [
        "need",
        "kind",
        "consumers",
        "when_unbound",
        "reason"
      ]
    },
    "UnboundAction": {
      "description": "What a need says to do when nothing binds it, without the fallback value\nthat a need may carry. The value is a local-only literal, so the plan\nnever repeats it outside a binding on a local target.",
      "oneOf": [
        {
          "description": "The units that need it fail.",
          "type": "string",
          "const": "fail"
        },
        {
          "description": "The app runs without it.",
          "type": "string",
          "const": "omit"
        },
        {
          "description": "The need names a fallback value.",
          "type": "string",
          "const": "fallback"
        }
      ]
    },
    "UnboundReason": {
      "description": "Why a need has no binding.",
      "oneOf": [
        {
          "description": "No binding record, want or bind gave an offer.",
          "type": "string",
          "const": "no_offer"
        },
        {
          "description": "A binding record names an offer that the store does not hold.",
          "type": "object",
          "properties": {
            "offer_missing": {
              "description": "References an offer record at /jumpgate/offers/<provider-kind>/<provider>/<name>.",
              "type": "string",
              "format": "board-ref",
              "pattern": "^/jumpgate/offers/(secret-store|app|workspace|capability|cloud-environment|identity-broker)/[a-z0-9][a-z0-9_-]{0,63}/[a-z0-9][a-z0-9_-]{0,63}$"
            }
          },
          "additionalProperties": false,
          "required": [
            "offer_missing"
          ]
        },
        {
          "description": "Two or more offers match the need, and the matcher binds none of\nthem.",
          "type": "object",
          "properties": {
            "ambiguous": {
              "type": "array",
              "items": {
                "description": "References an offer record at /jumpgate/offers/<provider-kind>/<provider>/<name>.",
                "type": "string",
                "format": "board-ref",
                "pattern": "^/jumpgate/offers/(secret-store|app|workspace|capability|cloud-environment|identity-broker)/[a-z0-9][a-z0-9_-]{0,63}/[a-z0-9][a-z0-9_-]{0,63}$"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "ambiguous"
          ]
        },
        {
          "description": "Only the need's fallback value would meet it, and the target is a\ncloud target, which never takes a fallback.",
          "type": "string",
          "const": "fallback_on_cloud"
        }
      ]
    },
    "UnitReference": {
      "description": "A unit of an app, an mxv process or container.",
      "type": "object",
      "properties": {
        "app": {
          "description": "The app.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "unit": {
          "description": "The unit's name.",
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
        }
      },
      "additionalProperties": false,
      "required": [
        "app",
        "unit"
      ]
    },
    "Via": {
      "description": "How a need was matched to what it receives.",
      "oneOf": [
        {
          "description": "A binding record in the target's authority store named the offer.",
          "type": "string",
          "const": "binding"
        },
        {
          "description": "The need's want names the offer's repository and provide.",
          "type": "string",
          "const": "want"
        },
        {
          "description": "The offer is the one a starmap bind derives.",
          "type": "string",
          "const": "bind"
        },
        {
          "description": "Nothing matched, and the need's fallback value is used on a local\ntarget.",
          "type": "string",
          "const": "fallback"
        }
      ]
    }
  }
}
